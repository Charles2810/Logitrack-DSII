@page "/rastreo"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthenticationStateProvider AuthProvider

<PageTitle>LogiTrack Solutions · Rastreo de envíos</PageTitle>

<MudAppBar Elevation="2" Class="px-4">
    <MudImage Src="logo.png" Alt="LogiTrack" Width="36" Height="36" Class="mr-2 rounded" />
    <MudText Typo="Typo.h6" Style="font-weight:700;">LogiTrack Solutions</MudText>
    <MudSpacer />
    @if (_autenticado)
    {
        <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.SpaceDashboard">
            Volver al sistema
        </MudButton>
    }
    else
    {
        <MudButton Href="/login" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">
            Iniciar sesión
        </MudButton>
    }
</MudAppBar>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-10 mb-8">
    <RastreoTracker />

    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-4" Align="Align.Center">
        LogiTrack Solutions · Trazabilidad de envíos en tiempo real · La Paz, Bolivia
    </MudText>
</MudContainer>

@code {
    private bool _autenticado;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _autenticado = state.User.Identity?.IsAuthenticated == true;
    }
}
