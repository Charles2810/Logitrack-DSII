@page "/entregas"
@attribute [Authorize]
@inject ApiClient Api
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>LogiTrack Solutions · Entregas</PageTitle>

<div class="d-flex justify-space-between align-center flex-wrap gap-3 mb-4">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:800;">Entregas</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Comprobantes de entrega registrados con firma o fotografía (RN07).
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="BuscarAsync">Actualizar</MudButton>
</div>

<MudPaper Elevation="2">
    <MudTable @ref="_tabla" ServerData="CargarAsync" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Fecha de entrega</MudTh>
            <MudTh>Guía</MudTh>
            <MudTh>Destinatario</MudTh>
            <MudTh>Receptor</MudTh>
            <MudTh>Registrada por</MudTh>
            <MudTh align="Right">Comprobantes</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                         Href="@($"/guias/{context.IdGuia}")">
                    @context.CodigoGuia
                </MudChip>
            </MudTd>
            <MudTd>@context.Destinatario</MudTd>
            <MudTd>@(context.NombreReceptor ?? "No registrado")</MudTd>
            <MudTd>@context.Usuario</MudTd>
            <MudTd align="Right">
                <div class="d-flex gap-1 justify-end">
                    @if (!string.IsNullOrWhiteSpace(context.RutaFirma))
                    {
                        <MudTooltip Text="Ver firma">
                            <MudImage Src="@context.RutaFirma" Width="56" Height="42" Class="rounded"
                                      ObjectFit="ObjectFit.Contain" Style="cursor:zoom-in;"
                                      @onclick="@(() => AbrirImagen(context.RutaFirma))" />
                        </MudTooltip>
                    }
                    @if (!string.IsNullOrWhiteSpace(context.RutaFoto))
                    {
                        <MudTooltip Text="Ver fotografía">
                            <MudImage Src="@context.RutaFoto" Width="56" Height="42" Class="rounded"
                                      ObjectFit="ObjectFit.Cover" Style="cursor:zoom-in;"
                                      @onclick="@(() => AbrirImagen(context.RutaFoto))" />
                        </MudTooltip>
                    }
                    @if (string.IsNullOrWhiteSpace(context.RutaFirma) && string.IsNullOrWhiteSpace(context.RutaFoto))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Sin evidencia</MudText>
                    }
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="mud-text-secondary py-4">Aún no se registraron entregas.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }" RowsPerPageString="Filas por página" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<EntregaDto> _tabla = default!;

    private async Task<TableData<EntregaDto>> CargarAsync(TableState state, CancellationToken token)
    {
        try
        {
            var data = await Api.GetAsync<PagedResult<EntregaDto>>(
                $"api/entregas?page={state.Page + 1}&pageSize={state.PageSize}");

            return new TableData<EntregaDto>
            {
                Items = data?.Items ?? new List<EntregaDto>(),
                TotalItems = data?.Total ?? 0
            };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<EntregaDto> { Items = new List<EntregaDto>(), TotalItems = 0 };
        }
    }

    private Task BuscarAsync() => _tabla == null ? Task.CompletedTask : _tabla.ReloadServerData();

    private async Task AbrirImagen(string? ruta)
    {
        if (!string.IsNullOrWhiteSpace(ruta))
        {
            await JS.InvokeVoidAsync("open", ruta, "_blank");
        }
    }
}
