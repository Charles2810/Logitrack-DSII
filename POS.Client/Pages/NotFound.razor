@page "/not-found"
@layout EmptyLayout

<PageTitle>LogiTrack Solutions · Página no encontrada</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column justify-center align-center"
              Style="min-height: 80vh;">
    <MudPaper Elevation="3" Class="pa-8 text-center">
        <MudImage Src="logo.png" Alt="LogiTrack Solutions" Width="90" Height="90" Class="mb-3" />
        <MudText Typo="Typo.h3" Style="font-weight:800;">404</MudText>
        <MudText Typo="Typo.h6" Class="mb-2">Página no encontrada</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-5">
            La dirección solicitada no existe o fue movida dentro del sistema.
        </MudText>
        <div class="d-flex gap-2 justify-center flex-wrap">
            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.SpaceDashboard">Ir al panel</MudButton>
            <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Login">Iniciar sesión</MudButton>
        </div>
    </MudPaper>
</MudContainer>
