@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject ApiClient Api
@inject JwtAuthenticationStateProvider JwtAuth
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>LogiTrack Solutions · Iniciar sesión</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="10" md="7" lg="5">
        <MudPaper Elevation="4" Class="pa-6 pa-md-8">
            <div class="d-flex flex-column align-center mb-4">
                <MudImage Src="logo.png" Alt="LogiTrack Solutions" Width="110" Height="110" Class="mb-2" />
                <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: 800; letter-spacing:.5px;">
                    LogiTrack Solutions
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary">
                    Sistema de trazabilidad logística · UPDS
                </MudText>
            </div>

            @if (_errorVisible)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">@_error</MudAlert>
            }

            <EditForm Model="_model" OnValidSubmit="IngresarAsync">
                <DataAnnotationsValidator />
                <MudTextField @bind-Value="_model.Correo" Label="Correo electrónico" Variant="Variant.Outlined"
                              InputType="InputType.Email" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email" Immediate="true"
                              Class="mb-3" Disabled="_cargando" />
                <MudTextField @bind-Value="_model.Password" Label="Contraseña" Variant="Variant.Outlined"
                              InputType="@(_verPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_verPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _verPassword = !_verPassword)"
                              Immediate="true" Class="mb-4"
                              Disabled="_cargando" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Size="Size.Large" Disabled="_cargando">
                    @if (_cargando)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Inherit" />
                        <span>Verificando…</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                        <span>Ingresar al sistema</span>
                    }
                </MudButton>
            </EditForm>

            <MudDivider Class="my-5" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">Usuarios de demostración (contraseña: <b>LogiTrack2026!</b>)</MudText>
            <div class="d-flex flex-wrap gap-2">
                <MudChip T="string" OnClick="@(() => CargarDemo("ana.rojas@logitrack.test"))" Size="Size.Small">Admin. Logístico</MudChip>
                <MudChip T="string" OnClick="@(() => CargarDemo("luis.mendez@logitrack.test"))" Size="Size.Small">Admin. Sistema</MudChip>
                <MudChip T="string" OnClick="@(() => CargarDemo("carlos.soliz@logitrack.test"))" Size="Size.Small">Conductor</MudChip>
                <MudChip T="string" OnClick="@(() => CargarDemo("marta.vaca@logitrack.test"))" Size="Size.Small">Almacén</MudChip>
                <MudChip T="string" OnClick="@(() => CargarDemo("pedro.eguez@logitrack.test"))" Size="Size.Small">Supervisor</MudChip>
            </div>

            <div class="d-flex justify-space-between align-center mt-6">
                <MudButton Href="/rastreo" Variant="Variant.Text" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.TravelExplore" Size="Size.Small">
                    Rastrear mi envío
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">v1.0 · 2026</MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private readonly LoginRequest _model = new();
    private bool _cargando;
    private bool _verPassword;
    private bool _errorVisible;
    private string _error = string.Empty;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/", replace: true);
        }
    }

    private void CargarDemo(string correo)
    {
        if (string.IsNullOrWhiteSpace(correo))
        {
            return;
        }

        _model.Correo = correo;
        _model.Password = "LogiTrack2026!";
    }

    private async Task IngresarAsync()
    {
        _cargando = true;
        _errorVisible = false;

        try
        {
            var respuesta = await Api.PostAsync<AuthResponse>("api/auth/login", new LoginRequest
            {
                Correo = _model.Correo.Trim(),
                Password = _model.Password
            });

            if (respuesta == null || string.IsNullOrWhiteSpace(respuesta.Token))
            {
                _error = "No se pudo iniciar sesión. Verifique sus credenciales.";
                _errorVisible = true;
                return;
            }

            await JwtAuth.SignInAsync(respuesta);
            Snackbar.Add($"Bienvenido(a), {respuesta.NombreCompleto}", Severity.Success);

            var destino = string.IsNullOrWhiteSpace(ReturnUrl) || ReturnUrl == "/login" ? "/" : ReturnUrl;
            Nav.NavigateTo(destino, replace: true);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _errorVisible = true;
        }
        catch (Exception ex)
        {
            _error = "No se pudo conectar con el servidor: " + ex.Message;
            _errorVisible = true;
        }
        finally
        {
            _cargando = false;
        }
    }
}
