<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700;">Registrar checkpoint</MudText>
    </TitleContent>
    <DialogContent>
        @if (_cargando)
        {
            <div class="d-flex justify-center py-6"><MudProgressCircular Indeterminate="true" /></div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
            }

            <MudText Typo="Typo.body2" Class="mb-1">
                Guía <b>@Guia?.CodigoGuia</b> · estado actual: <b>@Guia?.HitoActual</b>
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Destino: @Guia?.Destinatario — @Guia?.DireccionDestino
            </MudText>

            @if (_siguiente == null)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                    La guía ya se encuentra en el hito final. No hay más checkpoints por registrar.
                </MudAlert>
            }
            else if (_siguiente.Nombre == Hitos.Entregado)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    El siguiente paso es la <b>entrega</b>. Regístrela desde la acción “Confirmar entrega” del detalle de la guía.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                    Siguiente hito de la ruta: <b>@_siguiente.Nombre</b> (orden @_siguiente.Orden).
                </MudAlert>

                <MudSelect T="int?" @bind-Value="_idAlmacen" Label="Almacén / estación (opcional)"
                           Variant="Variant.Outlined" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                           Class="mb-2">
                    @foreach (var a in _almacenes)
                    {
                        <MudSelectItem T="int?" Value="@a.IdAlmacen">@a.Nombre · @a.Ciudad</MudSelectItem>
                    }
                </MudSelect>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="GuardarAsync" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_guardando || _siguiente == null || _siguiente.Nombre == Hitos.Entregado">
            @if (_guardando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Inherit" />
            }
            Registrar checkpoint
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public GuiaDto? Guia { get; set; }

    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private CatalogosService Catalogos { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private HitoDto? _siguiente;
    private List<AlmacenDto> _almacenes = new();
    private int? _idAlmacen;
    private bool _cargando = true;
    private bool _guardando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cat = await Catalogos.GetAsync();
            _almacenes = cat.Almacenes;

            if (Guia != null)
            {
                _siguiente = await Api.GetAsync<HitoDto?>($"api/guias/{Guia.IdGuia}/siguiente-hito");
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        if (Guia == null || _siguiente == null)
        {
            return;
        }

        _guardando = true;
        _error = null;

        try
        {
            await Api.PostAsync<CheckpointDto>("api/checkpoints", new RegistrarCheckpointRequest
            {
                IdGuia = Guia.IdGuia,
                IdHito = _siguiente.IdHito,
                IdAlmacen = _idAlmacen
            });

            Snackbar.Add($"Checkpoint '{_siguiente.Nombre}' registrado.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
