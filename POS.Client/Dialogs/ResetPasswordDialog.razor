<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700;">Restablecer contraseña</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
        }

        <MudText Typo="Typo.body2" Class="mb-4">
            Usuario: <b>@Usuario?.NombreCompleto</b> (@Usuario?.Correo)
        </MudText>

        <MudTextField @bind-Value="_password" Label="Nueva contraseña" Variant="Variant.Outlined"
                      InputType="@(_ver ? InputType.Text : InputType.Password)" Adornment="Adornment.End"
                      AdornmentIcon="@(_ver ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _ver = !_ver)" HelperText="Mínimo 8 caracteres."
                      Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_confirmacion" Label="Confirmar contraseña" Variant="Variant.Outlined"
                      InputType="@(_ver ? InputType.Text : InputType.Password)" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="GuardarAsync" Variant="Variant.Filled" Color="Color.Warning" Disabled="_guardando">
            @if (_guardando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Inherit" />
            }
            Restablecer
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public UsuarioDto? Usuario { get; set; }

    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string _password = string.Empty;
    private string _confirmacion = string.Empty;
    private bool _ver;
    private bool _guardando;
    private string? _error;

    private async Task GuardarAsync()
    {
        if (Usuario == null)
        {
            return;
        }

        if (_password.Length < 8)
        {
            _error = "La contraseña debe tener al menos 8 caracteres.";
            return;
        }

        if (_password != _confirmacion)
        {
            _error = "Las contraseñas no coinciden.";
            return;
        }

        _guardando = true;
        _error = null;

        try
        {
            await Api.PostAsync($"api/usuarios/{Usuario.IdUsuario}/reset-password", new ResetPasswordRequest
            {
                Password = _password
            });

            Snackbar.Add("Contraseña restablecida correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
