<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700;">@(Edicion ? "Editar producto" : "Nuevo producto")</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
        }

        <MudTextField @bind-Value="_sku" Label="SKU" Variant="Variant.Outlined" MaxLength="40"
                      Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_nombre" Label="Nombre del producto" Variant="Variant.Outlined"
                      MaxLength="150" Required="true" Class="mb-3" />
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_peso" Label="Peso unitario (kg)"
                                 Variant="Variant.Outlined" Min="0.001m" Format="N3" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_volumen" Label="Volumen unitario (m³)"
                                 Variant="Variant.Outlined" Min="0.0001m" Format="N4" Required="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="GuardarAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_guardando">
            @if (_guardando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Inherit" />
            }
            @(Edicion ? "Guardar cambios" : "Crear producto")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProductoDto? Producto { get; set; }
    [Parameter] public bool Edicion { get; set; }

    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private CatalogosService Catalogos { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string _sku = string.Empty;
    private string _nombre = string.Empty;
    private decimal _peso;
    private decimal _volumen;
    private bool _guardando;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Edicion && Producto != null)
        {
            _sku = Producto.Sku;
            _nombre = Producto.Nombre;
            _peso = Producto.PesoUnitarioKg;
            _volumen = Producto.VolumenUnitarioM3;
        }
    }

    private async Task GuardarAsync()
    {
        if (string.IsNullOrWhiteSpace(_sku) || string.IsNullOrWhiteSpace(_nombre) || _peso <= 0 || _volumen <= 0)
        {
            _error = "Complete el SKU, el nombre, el peso y el volumen unitario.";
            return;
        }

        _guardando = true;
        _error = null;

        try
        {
            var request = new CrearProductoRequest
            {
                Sku = _sku.Trim().ToUpperInvariant(),
                Nombre = _nombre.Trim(),
                PesoUnitarioKg = _peso,
                VolumenUnitarioM3 = _volumen
            };

            if (Edicion && Producto != null)
            {
                await Api.PutAsync<ProductoDto>($"api/productos/{Producto.IdProducto}", request);
                Snackbar.Add("Producto actualizado correctamente.", Severity.Success);
            }
            else
            {
                await Api.PostAsync<ProductoDto>("api/productos", request);
                Snackbar.Add("Producto registrado correctamente.", Severity.Success);
            }

            Catalogos.Invalidar();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
