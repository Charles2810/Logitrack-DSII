@* Tarjeta KPI reutilizable *@
<MudPaper Elevation="2" Class="pa-5" Style="height:100%;">
    <div class="d-flex justify-space-between align-start">
        <div>
            <MudText Typo="Typo.overline" Class="mud-text-secondary">@Titulo</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:800;">@Valor</MudText>
            @if (!string.IsNullOrWhiteSpace(Detalle))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Detalle</MudText>
            }
        </div>
        <MudAvatar Color="@Color" Variant="Variant.Filled" Size="Size.Large">
            <MudIcon Icon="@Icono" />
        </MudAvatar>
    </div>
</MudPaper>

@code {
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public string? Detalle { get; set; }
    [Parameter] public string Icono { get; set; } = Icons.Material.Filled.Analytics;
    [Parameter] public Color Color { get; set; } = Color.Primary;
}
