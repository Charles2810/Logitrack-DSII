<MudPaper Width="100%" Height="100%" Elevation="0" Class="py-3">
    <MudNavMenu Class="px-2">
        <div class="d-flex align-center px-3 pb-2">
            <MudImage Src="logo.png" Alt="LogiTrack" Width="34" Height="34" Class="mr-2 rounded" />
            <div>
                <MudText Typo="Typo.subtitle1" Style="font-weight:700; line-height:1.1;">LogiTrack</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Soluciones Logísticas</MudText>
            </div>
        </div>
        <MudDivider Class="my-2" />

        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">
            Panel principal
        </MudNavLink>

        <MudNavGroup Title="Operación" Icon="@Icons.Material.Filled.LocalShipping" Expanded="true">
            <AuthorizeView Roles="@($"{Roles.AdministradorSistema},{Roles.AdministradorLogistico},{Roles.CentroControl}")">
                <MudNavLink Href="/guias" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description">
                    Guías de envío
                </MudNavLink>
            </AuthorizeView>
            <AuthorizeView Roles="@($"{Roles.AdministradorSistema},{Roles.AdministradorLogistico},{Roles.Conductor},{Roles.CentroControl}")">
                <MudNavLink Href="/hojas-ruta" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Route">
                    Hojas de ruta
                </MudNavLink>
            </AuthorizeView>
            <MudNavLink Href="/incidencias" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReportProblem">
                Incidencias
            </MudNavLink>
            <MudNavLink Href="/entregas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
                Entregas
            </MudNavLink>
        </MudNavGroup>

        <AuthorizeView Roles="@($"{Roles.AdministradorSistema},{Roles.AdministradorLogistico},{Roles.PersonalAlmacen}")">
            <MudNavGroup Title="Inventario" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
                <MudNavLink Href="/inventario" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">
                    Existencias
                </MudNavLink>
                <MudNavLink Href="/inventario/movimientos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SwapVert">
                    Movimientos
                </MudNavLink>
                <MudNavLink Href="/inventario/productos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">
                    Producto
                </MudNavLink>
            </MudNavGroup>
        </AuthorizeView>

        <AuthorizeView Roles="@($"{Roles.AdministradorSistema},{Roles.AdministradorLogistico},{Roles.CentroControl}")">
            <MudNavLink Href="/reportes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">
                Reportes
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="@($"{Roles.AdministradorSistema},{Roles.AdministradorLogistico}")">
            <MudNavGroup Title="Administración" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                <MudNavLink Href="/flota" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DirectionsCar">
                    Flota
                </MudNavLink>
                <AuthorizeView Roles="@Roles.AdministradorSistema" Context="admin">
                    <MudNavLink Href="/usuarios" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">
                        Usuarios
                    </MudNavLink>
                </AuthorizeView>
                <MudNavLink Href="/clientes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business">
                    Clientes
                </MudNavLink>
            </MudNavGroup>
        </AuthorizeView>

        <MudDivider Class="my-2" />
        <MudNavLink Href="/rastreo-interno" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TravelExplore">
            Rastreo público
        </MudNavLink>
        <MudNavLink Href="/notificaciones" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Notifications">
            Notificaciones
        </MudNavLink>
        <MudNavLink Href="/perfil" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">
            Mi perfil
        </MudNavLink>
    </MudNavMenu>
</MudPaper>
