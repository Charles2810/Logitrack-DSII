@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthProvider
@inject JwtAuthenticationStateProvider JwtAuth
@inject ApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Class="px-2">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudImage Src="logo.png" Alt="LogiTrack Solutions" Width="38" Height="38" Class="mr-2 rounded" />
        <MudText Typo="Typo.h6" Class="ml-1" Style="font-weight: 700; letter-spacing: .5px;">
            LogiTrack Solutions
        </MudText>
        <MudSpacer />

        <MudTooltip Text="Rastreo público">
            <MudIconButton Icon="@Icons.Material.Filled.TravelExplore" Color="Color.Inherit"
                           Href="/rastreo-interno" />
        </MudTooltip>

        <MudTooltip Text="Notificaciones">
            <MudBadge Content="@_noLeidas" Overlap="true" Color="Color.Error" BadgeClass="mt-1"
                      Visible="@(_noLeidas > 0)">
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit"
                               Href="/notificaciones" />
            </MudBadge>
        </MudTooltip>

        <MudToggleIconButton @bind-Toggled="_isDark" Icon="@Icons.Material.Filled.DarkMode"
                            Color="Color.Inherit" ToggledIcon="@Icons.Material.Filled.LightMode"
                            ToggledColor="Color.Warning" />

        <div style="position: relative;">
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                       OnClick="@(() => _menuUsuarioAbierto = !_menuUsuarioAbierto)">
                <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="mr-2" Style="font-weight:700;">
                    @Iniciales
                </MudAvatar>
                <div class="d-flex flex-column align-start" style="line-height: 1.1;">
                    <span style="font-size: .85rem;">@_nombre</span>
                    <span style="font-size: .70rem; opacity: .8;">@_rol</span>
                </div>
            </MudButton>

            @if (_menuUsuarioAbierto)
            {
                <div style="position: fixed; inset: 0; z-index: 1400;" @onclick="CerrarMenuUsuario"></div>
                <div style="position: absolute; top: calc(100% + 8px); right: 0; min-width: 260px; z-index: 1500;
                            background: var(--mud-palette-surface); color: var(--mud-palette-text-primary);
                            border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.28); padding: 8px;">
                    <div class="px-2 py-2 d-flex align-center">
                        <MudAvatar Color="Color.Secondary" Class="mr-3" Style="font-weight:700;">@Iniciales</MudAvatar>
                        <div class="d-flex flex-column" style="line-height: 1.2;">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@_nombre</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_rol</MudText>
                        </div>
                    </div>
                    <MudDivider Class="my-1" />
                    <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.ManageAccounts"
                               FullWidth="true" Class="justify-start" OnClick="IrAPerfil">Mi perfil</MudButton>
                    <div class="mt-1">
                        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout"
                                   FullWidth="true" OnClick="CerrarSesion">Cerrar sesión</MudButton>
                    </div>
                </div>
            }
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 pt-2">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _menuUsuarioAbierto;
    private bool _isDark;
    private string _nombre = "Usuario";
    private string _rol = string.Empty;
    private int _noLeidas;
    private bool _autenticado;
    private Timer? _timer;

    private string Iniciales
    {
        get
        {
            var partes = _nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return partes.Length >= 2
                ? $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant()
                : (_nombre.Length > 0 ? _nombre[..1].ToUpperInvariant() : "LT");
        }
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0B6E4F",
            Secondary = "#F4A300",
            AppbarBackground = "#0B6E4F",
            DrawerBackground = "#F7FAF8",
            Background = "#F4F7F5"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#37C99B",
            Secondary = "#FFC24D",
            AppbarBackground = "#10231C"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px" },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = new[] { "Segoe UI", "Roboto", "Arial", "sans-serif" } }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        Api.SesionExpirada += OnSesionExpirada;
        Nav.LocationChanged += OnLocationChanged;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        _autenticado = state.User.Identity?.IsAuthenticated == true;
        _nombre = state.User.Identity?.Name ?? "Usuario";
        _rol = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;

        if (_autenticado)
        {
            await ActualizarNotificacionesAsync();

            _timer = new Timer(async _ => await InvokeAsync(async () =>
            {
                await ActualizarNotificacionesAsync();
                StateHasChanged();
            }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(60));
        }
    }

    private async Task ActualizarNotificacionesAsync()
    {
        if (!_autenticado)
        {
            _noLeidas = 0;
            return;
        }

        try
        {
            var data = await Api.GetAsync<NoLeidasDto>("api/notificaciones/no-leidas");
            _noLeidas = data?.Total ?? 0;
        }
        catch
        {
            // silencioso: el badge no debe romper la navegación
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _menuUsuarioAbierto = false;
        await ActualizarNotificacionesAsync();
        StateHasChanged();
    }

    private async void OnSesionExpirada()
    {
        await JwtAuth.SignOutAsync();
        Snackbar.Add("Su sesión expiró. Inicie sesión nuevamente.", Severity.Warning);
        Nav.NavigateTo("/login");
    }

    private void CerrarMenuUsuario() => _menuUsuarioAbierto = false;

    private void IrAPerfil()
    {
        _menuUsuarioAbierto = false;
        Nav.NavigateTo("/perfil");
    }

    private async Task CerrarSesion()
    {
        _menuUsuarioAbierto = false;
        await JwtAuth.SignOutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Api.SesionExpirada -= OnSesionExpirada;
        Nav.LocationChanged -= OnLocationChanged;
        _timer?.Dispose();
    }

    private class NoLeidasDto
    {
        public int Total { get; set; }
    }
}
